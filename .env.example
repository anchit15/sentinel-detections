# Kusto emulator connection (see docker-compose.yml)
# Host port the emulator listens on; keep it in step with KUSTO_CLUSTER_URL
KUSTO_PORT=8080
KUSTO_CLUSTER_URL=http://localhost:8080
KUSTO_DATABASE=NetDefaultDB
# Folder inside the emulator container where ./data is mounted; the loader ingests from here
KUSTO_DATA_DIR=/kustodata
