{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Microsoft Sentinel scheduled analytics rule",
  "$comment": "Fields, enums and limits follow Sentinel's template validator (ScheduledTemplateInternalModel and its base classes, Azure/Azure-Sentinel@863e9128d3fbcda27fc2ce54a9cd00b7c61d155e, .script/tests/detectionTemplateSchemaValidation). Entity identifiers follow https://learn.microsoft.com/en-us/azure/sentinel/entities-reference (retrieved 2026-11-17). Stricter than Sentinel on purpose: unknown fields are rejected, entityMappings and version are required, time spans must use the <n>m|h|d form, and dataTypes are limited to the tables this project loads.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "description",
    "severity",
    "requiredDataConnectors",
    "queryFrequency",
    "queryPeriod",
    "triggerOperator",
    "triggerThreshold",
    "tactics",
    "relevantTechniques",
    "query",
    "entityMappings",
    "version",
    "kind"
  ],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "name": { "type": "string", "minLength": 1, "maxLength": 256 },
    "description": { "type": "string", "minLength": 1, "maxLength": 5000 },
    "severity": { "enum": ["Informational", "Low", "Medium", "High"] },
    "requiredDataConnectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["connectorId", "dataTypes"],
        "properties": {
          "connectorId": { "type": "string", "minLength": 1 },
          "dataTypes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["SecurityEvent", "Event"] }
          }
        }
      }
    },
    "queryFrequency": { "$ref": "#/$defs/timeSpan" },
    "queryPeriod": { "$ref": "#/$defs/timeSpan" },
    "triggerOperator": {
      "enum": ["gt", "lt", "eq", "ne", "GreaterThan", "LessThan", "Equal", "NotEqual"]
    },
    "triggerThreshold": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "tactics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "Reconnaissance",
          "ResourceDevelopment",
          "InitialAccess",
          "Execution",
          "Persistence",
          "PrivilegeEscalation",
          "DefenseEvasion",
          "CredentialAccess",
          "Discovery",
          "LateralMovement",
          "Collection",
          "Exfiltration",
          "CommandAndControl",
          "Impact",
          "ImpairProcessControl",
          "InhibitResponseFunction",
          "PreAttack"
        ]
      }
    },
    "relevantTechniques": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$" }
    },
    "query": { "type": "string", "minLength": 1, "maxLength": 10000 },
    "entityMappings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/entityMapping" }
    },
    "version": { "type": "string", "maxLength": 20, "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "kind": { "const": "Scheduled" }
  },
  "$defs": {
    "timeSpan": {
      "$comment": "Sentinel accepts 5m to 14d; the numeric range is checked in Python.",
      "type": "string",
      "pattern": "^[1-9][0-9]*[mhd]$"
    },
    "entityMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entityType", "fieldMappings"],
      "properties": {
        "entityType": {
          "enum": [
            "Account",
            "Host",
            "IP",
            "Malware",
            "File",
            "Process",
            "CloudApplication",
            "DNS",
            "AzureResource",
            "FileHash",
            "RegistryKey",
            "RegistryValue",
            "SecurityGroup",
            "URL",
            "IoTDevice",
            "Mailbox",
            "MailCluster",
            "MailMessage",
            "SubmissionMail"
          ]
        },
        "fieldMappings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["identifier", "columnName"],
            "properties": {
              "identifier": { "type": "string", "minLength": 1 },
              "columnName": { "type": "string", "minLength": 1 }
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "entityType": { "const": "Account" } } },
          "then": {
            "properties": {
              "fieldMappings": {
                "items": {
                  "properties": {
                    "identifier": {
                      "enum": [
                        "Name",
                        "FullName",
                        "NTDomain",
                        "DnsDomain",
                        "UPNSuffix",
                        "Sid",
                        "AadTenantId",
                        "AadUserId",
                        "PUID",
                        "IsDomainJoined",
                        "DisplayName",
                        "ObjectGuid"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "entityType": { "const": "Host" } } },
          "then": {
            "properties": {
              "fieldMappings": {
                "items": {
                  "properties": {
                    "identifier": {
                      "enum": [
                        "DnsDomain",
                        "NTDomain",
                        "HostName",
                        "FullName",
                        "NetBiosName",
                        "AzureID",
                        "OMSAgentID",
                        "OSFamily",
                        "OSVersion",
                        "IsDomainJoined"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "entityType": { "const": "IP" } } },
          "then": {
            "properties": {
              "fieldMappings": {
                "items": { "properties": { "identifier": { "enum": ["Address", "AddressScope"] } } }
              }
            }
          }
        },
        {
          "if": { "properties": { "entityType": { "const": "File" } } },
          "then": {
            "properties": {
              "fieldMappings": {
                "items": { "properties": { "identifier": { "enum": ["Directory", "Name"] } } }
              }
            }
          }
        },
        {
          "if": { "properties": { "entityType": { "const": "Process" } } },
          "then": {
            "properties": {
              "fieldMappings": {
                "items": {
                  "properties": {
                    "identifier": {
                      "enum": ["ProcessId", "CommandLine", "ElevationToken", "CreationTimeUtc"]
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "entityType": { "const": "FileHash" } } },
          "then": {
            "properties": {
              "fieldMappings": {
                "items": { "properties": { "identifier": { "enum": ["Algorithm", "Value"] } } }
              }
            }
          }
        },
        {
          "if": { "properties": { "entityType": { "const": "RegistryKey" } } },
          "then": {
            "properties": {
              "fieldMappings": {
                "items": { "properties": { "identifier": { "enum": ["Hive", "Key"] } } }
              }
            }
          }
        },
        {
          "if": { "properties": { "entityType": { "const": "RegistryValue" } } },
          "then": {
            "properties": {
              "fieldMappings": {
                "items": {
                  "properties": { "identifier": { "enum": ["Name", "Value", "ValueType"] } }
                }
              }
            }
          }
        }
      ]
    }
  }
}
